// Palms in Aruba Car Detailing — data model
// Currency for all monetary fields is AWG (Aruban Florin), stored as Decimal(10,2).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// AUTH / USERS — internal staff accounts. Role gates Finance/Customers/Settings.
// ---------------------------------------------------------------------------

enum UserRole {
  OWNER
  MANAGER
  STAFF
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          UserRole  @default(STAFF)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  jobsAssigned  Job[]     @relation("AssignedTech")
}

// ---------------------------------------------------------------------------
// CUSTOMERS
// ---------------------------------------------------------------------------

enum LeadSource {
  INSTAGRAM
  TIKTOK
  FACEBOOK
  WHATSAPP
  REFERRAL
  GOOGLE
  FLYER
  WORD_OF_MOUTH
  OTHER
}

enum CustomerStatus {
  LEAD
  NEW
  ACTIVE
  RECURRING
  INACTIVE
  VIP
}

enum ContactMethod {
  WHATSAPP
  PHONE
  EMAIL
  INSTAGRAM
}

model Customer {
  id                    String          @id @default(cuid())
  fullName              String
  phone                 String
  email                 String?
  address               String?
  preferredContact      ContactMethod   @default(WHATSAPP)
  leadSource            LeadSource      @default(OTHER)
  dateAcquired          DateTime        @default(now())
  status                CustomerStatus  @default(LEAD)
  notes                 String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  vehicles              Vehicle[]
  appointments          Appointment[]
  payments              Payment[]
  leads                 Lead[]
  recurringPlans        RecurringPlan[]
  reviews               Review[]
  referralsGiven        Referral[]      @relation("ReferringCustomer")
  referralsReceived     Referral[]      @relation("ReferredCustomer")

  @@index([status])
  @@index([leadSource])
}

// ---------------------------------------------------------------------------
// VEHICLES
// ---------------------------------------------------------------------------

enum VehicleType {
  SEDAN
  SUV
  TRUCK
  VAN
  COUPE
  CONVERTIBLE
  MOTORCYCLE
  OTHER
}

model Vehicle {
  id                    String        @id @default(cuid())
  customerId            String
  customer              Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  make                  String
  model                 String
  year                  Int?
  color                 String?
  licensePlate          String?
  vehicleType           VehicleType   @default(SEDAN)
  interiorMaterial      String?
  specialNotes          String?
  conditionNotes        String?
  lastDetailed          DateTime?
  nextRecommendedDate   DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  appointments          Appointment[]
  recurringPlans        RecurringPlan[]

  @@index([customerId])
}

// ---------------------------------------------------------------------------
// SERVICES & ADD-ONS — prices configurable, never hardcoded in app logic.
// ---------------------------------------------------------------------------

enum ServiceCategory {
  BASIC
  STANDARD
  PREMIUM
}

model Service {
  id                String          @id @default(cuid())
  name              String
  description       String?
  category          ServiceCategory @default(BASIC)
  startingPrice     Decimal         @db.Decimal(10, 2)
  estimatedDuration Int             // minutes
  laborMinutes      Int             // minutes allocated for labor cost calc
  materialCost      Decimal         @db.Decimal(10, 2) @default(0)
  travelCost        Decimal         @db.Decimal(10, 2) @default(0)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  appointmentServices AppointmentService[]
  recurringPlans      RecurringPlan[]
}

model AddOn {
  id           String   @id @default(cuid())
  name         String
  description  String?
  price        Decimal  @db.Decimal(10, 2)
  materialCost Decimal  @db.Decimal(10, 2) @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  appointmentAddOns AppointmentAddOn[]
}

// ---------------------------------------------------------------------------
// APPOINTMENTS / JOBS
// ---------------------------------------------------------------------------

enum AppointmentStatus {
  INQUIRY
  QUOTED
  BOOKED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

model Appointment {
  id                String             @id @default(cuid())
  customerId        String
  customer          Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicleId         String
  vehicle           Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  scheduledDate     DateTime
  location          String?
  status            AppointmentStatus  @default(INQUIRY)
  paymentStatus     PaymentStatus      @default(UNPAID)
  quotedPrice       Decimal?           @db.Decimal(10, 2)
  finalPrice        Decimal?           @db.Decimal(10, 2)
  estimatedDuration Int?               // minutes
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  services          AppointmentService[]
  addOns            AppointmentAddOn[]
  photos            Photo[]
  checklist         ChecklistItem[]
  job               Job?
  payments          Payment[]
  review            Review?
  referral          Referral?

  @@index([status])
  @@index([scheduledDate])
  @@index([customerId])
  @@index([vehicleId])
}

model AppointmentService {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceId     String
  service       Service     @relation(fields: [serviceId], references: [id])
  priceAtBooking Decimal    @db.Decimal(10, 2)

  @@index([appointmentId])
}

model AppointmentAddOn {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  addOnId       String
  addOn         AddOn       @relation(fields: [addOnId], references: [id])
  priceAtBooking Decimal    @db.Decimal(10, 2)

  @@index([appointmentId])
}

enum PhotoStage {
  BEFORE
  AFTER
}

model Photo {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  stage         PhotoStage
  url           String
  caption       String?
  createdAt     DateTime    @default(now())

  @@index([appointmentId])
}

enum ChecklistSection {
  BEFORE_SERVICE
  EXTERIOR
  INTERIOR
  FINAL_INSPECTION
}

model ChecklistItem {
  id            String           @id @default(cuid())
  appointmentId String
  appointment   Appointment      @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  section       ChecklistSection
  label         String
  isDone        Boolean          @default(false)
  sortOrder     Int              @default(0)

  @@index([appointmentId])
}

// A Job represents the operational + cost record tied 1:1 to a completed/active appointment.
model Job {
  id               String    @id @default(cuid())
  appointmentId    String    @unique
  appointment      Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  assignedToId     String?
  assignedTo       User?     @relation("AssignedTech", fields: [assignedToId], references: [id])
  startedAt        DateTime?
  completedAt      DateTime?
  laborRateApplied Decimal?  @db.Decimal(10, 2) // AWG allocated for labor on this job
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  costs            JobCost[]
  inventoryUses    InventoryTransaction[]
}

enum JobCostType {
  MATERIAL
  TRAVEL
  LABOR
  OTHER
}

model JobCost {
  id        String      @id @default(cuid())
  jobId     String
  job       Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  type      JobCostType
  amount    Decimal     @db.Decimal(10, 2)
  note      String?
  createdAt DateTime    @default(now())

  @@index([jobId])
}

// ---------------------------------------------------------------------------
// PAYMENTS
// ---------------------------------------------------------------------------

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  WHATSAPP_PAY
  OTHER
}

model Payment {
  id            String        @id @default(cuid())
  appointmentId String
  appointment   Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  amount        Decimal       @db.Decimal(10, 2) // AWG
  method        PaymentMethod @default(CASH)
  paidAt        DateTime      @default(now())
  notes         String?

  @@index([appointmentId])
  @@index([customerId])
  @@index([paidAt])
}

// ---------------------------------------------------------------------------
// EXPENSES
// ---------------------------------------------------------------------------

enum ExpenseCategory {
  CHEMICALS
  EQUIPMENT
  EQUIPMENT_MAINTENANCE
  FUEL
  TRANSPORTATION
  MARKETING
  ADVERTISING
  SOFTWARE
  PHONE
  SUPPLIES
  LABOR
  INSURANCE
  OTHER
}

model Expense {
  id           String          @id @default(cuid())
  date         DateTime
  category     ExpenseCategory
  description  String
  amount       Decimal         @db.Decimal(10, 2) // AWG
  paymentMethod PaymentMethod  @default(CASH)
  isRecurring  Boolean         @default(false)
  vendor       String?
  notes        String?
  createdAt    DateTime        @default(now())

  @@index([date])
  @@index([category])
}

// ---------------------------------------------------------------------------
// INVENTORY
// ---------------------------------------------------------------------------

enum InventoryCategory {
  CHEMICALS
  EQUIPMENT
  SUPPLIES
  OTHER
}

model InventoryItem {
  id             String            @id @default(cuid())
  name           String
  category       InventoryCategory @default(SUPPLIES)
  unit           String            // e.g. "L", "bottle", "pack"
  currentStock   Decimal           @db.Decimal(10, 2) @default(0)
  minimumStock   Decimal           @db.Decimal(10, 2) @default(0)
  purchasePrice  Decimal           @db.Decimal(10, 2) @default(0) // per unit, AWG
  supplier       String?
  costPerUse     Decimal?          @db.Decimal(10, 2)
  lastPurchase   DateTime?
  nextPurchase   DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  transactions   InventoryTransaction[]

  @@index([category])
}

enum InventoryTransactionType {
  PURCHASE
  USAGE
  ADJUSTMENT
}

model InventoryTransaction {
  id              String                    @id @default(cuid())
  itemId          String
  item            InventoryItem             @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type            InventoryTransactionType
  quantity        Decimal                   @db.Decimal(10, 2) // positive for purchase, negative for usage
  jobId           String?
  job             Job?                      @relation(fields: [jobId], references: [id])
  note            String?
  createdAt       DateTime                  @default(now())

  @@index([itemId])
  @@index([jobId])
}

// ---------------------------------------------------------------------------
// MARKETING — LEADS, CAMPAIGNS, CONTENT
// ---------------------------------------------------------------------------

enum LeadStatus {
  NEW
  CONTACTED
  QUOTED
  FOLLOW_UP
  BOOKED
  LOST
  CONVERTED
}

model Lead {
  id                String     @id @default(cuid())
  name              String
  phone             String
  vehicleDescription String?
  source            LeadSource @default(OTHER)
  date              DateTime   @default(now())
  requestedService  String?
  estimatedValue    Decimal?   @db.Decimal(10, 2)
  status            LeadStatus @default(NEW)
  notes             String?
  customerId        String?
  customer          Customer?  @relation(fields: [customerId], references: [id])
  campaignId        String?
  campaign          Campaign?  @relation(fields: [campaignId], references: [id])
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([status])
  @@index([source])
}

enum CampaignPlatform {
  INSTAGRAM
  TIKTOK
  FACEBOOK
  WHATSAPP
  GOOGLE
  FLYER
  OTHER
}

model Campaign {
  id           String            @id @default(cuid())
  name         String
  platform     CampaignPlatform  @default(OTHER)
  startDate    DateTime
  endDate      DateTime?
  budget       Decimal?          @db.Decimal(10, 2) // AWG
  isActive     Boolean           @default(true)
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  leads        Lead[]
}

enum ContentCategory {
  BEFORE_AFTER
  SATISFYING_CLEANING
  EDUCATIONAL
  TESTIMONIAL
  BUSINESS_JOURNEY
  BEHIND_THE_SCENES
  PROMOTION
  MAINTENANCE_TIPS
}

enum ContentPlatform {
  INSTAGRAM
  TIKTOK
  FACEBOOK
}

enum ContentStatus {
  IDEA
  SCHEDULED
  PUBLISHED
}

model ContentItem {
  id                 String          @id @default(cuid())
  title              String
  platform           ContentPlatform
  category           ContentCategory
  status             ContentStatus   @default(IDEA)
  scheduledDate      DateTime?
  publishedDate      DateTime?
  views              Int             @default(0)
  likes              Int             @default(0)
  comments            Int             @default(0)
  shares             Int             @default(0)
  leadsGenerated     Int             @default(0)
  customersGenerated Int             @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

// ---------------------------------------------------------------------------
// REFERRALS
// ---------------------------------------------------------------------------

enum RewardStatus {
  PENDING
  GIVEN
  NA
}

model Referral {
  id                  String        @id @default(cuid())
  referringCustomerId String
  referringCustomer   Customer      @relation("ReferringCustomer", fields: [referringCustomerId], references: [id])
  referredCustomerId  String        @unique
  referredCustomer    Customer      @relation("ReferredCustomer", fields: [referredCustomerId], references: [id])
  appointmentId       String?       @unique
  appointment         Appointment?  @relation(fields: [appointmentId], references: [id])
  date                DateTime      @default(now())
  bookingValue        Decimal?      @db.Decimal(10, 2)
  rewardDescription   String?
  rewardStatus        RewardStatus  @default(PENDING)
  createdAt           DateTime      @default(now())

  @@index([referringCustomerId])
}

// ---------------------------------------------------------------------------
// REVIEWS
// ---------------------------------------------------------------------------

enum ReviewPlatform {
  GOOGLE
  INSTAGRAM
  FACEBOOK
  WHATSAPP
}

model Review {
  id              String          @id @default(cuid())
  appointmentId   String          @unique
  appointment     Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  customerId      String
  customer        Customer        @relation(fields: [customerId], references: [id])
  requested       Boolean         @default(false)
  requestedAt     DateTime?
  received        Boolean         @default(false)
  receivedAt      DateTime?
  platform        ReviewPlatform?
  rating          Int?            // 1-5
  comment         String?
  createdAt       DateTime        @default(now())

  @@index([customerId])
}

// ---------------------------------------------------------------------------
// RECURRING CUSTOMERS
// ---------------------------------------------------------------------------

enum RecurringFrequency {
  ONE_TIME
  BIWEEKLY
  MONTHLY
  CUSTOM
}

enum RecurringStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

model RecurringPlan {
  id             String              @id @default(cuid())
  customerId     String
  customer       Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicleId      String
  vehicle        Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  serviceId      String
  service        Service             @relation(fields: [serviceId], references: [id])
  frequency      RecurringFrequency  @default(MONTHLY)
  customDays     Int?                // used when frequency = CUSTOM
  price          Decimal             @db.Decimal(10, 2)
  lastServiceDate DateTime?
  nextServiceDate DateTime?
  status         RecurringStatus     @default(ACTIVE)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status])
  @@index([nextServiceDate])
}

// ---------------------------------------------------------------------------
// BUSINESS SETTINGS & KPI TARGETS
// ---------------------------------------------------------------------------

model BusinessSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String // JSON-encoded value; e.g. labor rate per hour, default travel cost
}

model KpiTarget {
  id                     String   @id @default(cuid())
  label                  String   // e.g. "December 2026"
  periodStart            DateTime
  periodEnd              DateTime
  targetCustomers        Int?
  targetAverageTicket    Decimal? @db.Decimal(10, 2)
  targetRevenue          Decimal? @db.Decimal(10, 2)
  targetExpenses         Decimal? @db.Decimal(10, 2)
  targetProfit           Decimal? @db.Decimal(10, 2)
  targetRepeatCustomers  Int?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}
